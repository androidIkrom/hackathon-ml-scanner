<?xml version="1.0" encoding="utf-8"?>
<!-- Owner I. Destination ids and arguments are a frozen contract: A and Y read them through safe-args. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/home">

    <!-- I -->
    <fragment
        android:id="@+id/home"
        android:name="com.nungil.shell.HomeFragment"
        android:label="@string/nav_title_home" />
    <fragment
        android:id="@+id/onboarding"
        android:name="com.nungil.shell.OnboardingFragment"
        android:label="@string/nav_title_onboarding" />
    <fragment
        android:id="@+id/scan_hub"
        android:name="com.nungil.shell.ScanHubFragment"
        android:label="@string/nav_title_scan_hub" />
    <fragment
        android:id="@+id/settings"
        android:name="com.nungil.shell.SettingsFragment"
        android:label="@string/nav_title_settings" />
    <fragment
        android:id="@+id/history"
        android:name="com.nungil.shell.HistoryFragment"
        android:label="@string/nav_title_history" />

    <!-- A -->
    <fragment
        android:id="@+id/scan"
        android:name="com.nungil.scan.ScanFragment"
        android:label="@string/nav_title_scan">
        <argument
            android:name="mode"
            app:argType="com.nungil.contract.ScanMode" />
    </fragment>
    <fragment
        android:id="@+id/walk"
        android:name="com.nungil.walk.WalkFragment"
        android:label="@string/nav_title_walk" />

    <!-- Y -->
    <fragment
        android:id="@+id/search"
        android:name="com.nungil.search.SearchFragment"
        android:label="@string/nav_title_search">
        <argument
            android:name="query"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/search_camera"
        android:name="com.nungil.search.SearchCameraFragment"
        android:label="@string/nav_title_search_camera">
        <!-- LABEL, PERSON or ITEM -->
        <argument
            android:name="targetType"
            app:argType="string" />
        <argument
            android:name="targetId"
            android:defaultValue="-1L"
            app:argType="long" />
        <argument
            android:name="targetLabel"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="spokenName"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/saved"
        android:name="com.nungil.saved.SavedFragment"
        android:label="@string/nav_title_saved">
        <!-- SavedTab ordinal, or -1 -->
        <argument
            android:name="tab"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>
    <fragment
        android:id="@+id/person"
        android:name="com.nungil.people.PersonFragment"
        android:label="@string/nav_title_person">
        <argument
            android:name="personId"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/add_person"
        android:name="com.nungil.people.AddPersonFragment"
        android:label="@string/nav_title_add_person">
        <argument
            android:name="name"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/enroll"
        android:name="com.nungil.people.EnrollFragment"
        android:label="@string/nav_title_enroll">
        <argument
            android:name="name"
            app:argType="string" />
        <argument
            android:name="front"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>
    <fragment
        android:id="@+id/item"
        android:name="com.nungil.items.ItemFragment"
        android:label="@string/nav_title_item">
        <argument
            android:name="itemId"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/add_item"
        android:name="com.nungil.items.AddItemFragment"
        android:label="@string/nav_title_add_item">
        <argument
            android:name="kind"
            app:argType="com.nungil.contract.ItemKind" />
        <argument
            android:name="name"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/item_enroll"
        android:name="com.nungil.items.ItemEnrollFragment"
        android:label="@string/nav_title_item_enroll">
        <argument
            android:name="name"
            app:argType="string" />
        <argument
            android:name="kind"
            app:argType="com.nungil.contract.ItemKind" />
    </fragment>
    <fragment
        android:id="@+id/reader"
        android:name="com.nungil.reader.ReaderFragment"
        android:label="@string/nav_title_reader" />
</navigation>
