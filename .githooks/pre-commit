#!/usr/bin/env bash
# main changes only through a pull request, so CI runs the unit tests first. Enable once per clone:
#   git config core.hooksPath .githooks
# One developer since 2026-10-04: every file is theirs, and a branch may have any name.
if [ "$(git rev-parse --abbrev-ref HEAD)" = "main" ]; then
    echo "Commit on a branch and open a pull request: main changes only through one."
    exit 1
fi
